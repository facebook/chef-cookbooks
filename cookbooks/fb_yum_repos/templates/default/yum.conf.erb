# Generated by MetalOS during provisioning and managed by Chef during runtime.
<% @config.each do |section, section_config| %>

[<%= section %>]
<%   section_config.sort.each do |key, val| %>
<%=    key %>=<%= FB::YumRepos.gen_config_value(key, val) %>
<%   end %>
<% end %>
<% repos = @repos.flat_map do |group, group_config|
     FB::YumRepos.gen_group_config(node, group, group_config)['repos'].to_a
   end %>
<% repos.sort_by(&:first).each do |repo, repo_config| %>
<%=  FB::YumRepos.gen_repo_entry(node, repo, repo_config).chomp %>
<% end %>
